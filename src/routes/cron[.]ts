import { createFileRoute } from "@tanstack/react-router";
import { supabase } from "@/integrations/supabase/client";

export const Route = createFileRoute("/cron")({
  server: {
    handlers: {
      GET: async ({ request }) => {
        return handleCron(request);
      },
      POST: async ({ request }) => {
        return handleCron(request);
      },
    },
  },
});

async function handleCron(request: Request) {
  try {
    const { AutomationEngine } = await import("@/services/automation-engine.server");
    const engine = new AutomationEngine();
    const result = await engine.executeFullPipeline();

    const jobId = `cron-${Date.now()}`;

    return new Response(
      JSON.stringify({
        success: true,
        message: "Cron job executed successfully & rates refreshed",
        jobId,
        status: result.status,
        coveragePercent: result.coveragePercent,
        timestamp: new Date().toISOString(),
      }),
      {
        status: 200,
        headers: {
          "Content-Type": "application/json",
          "Cache-Control": "no-store, no-cache, must-revalidate",
        },
      }
    );
  } catch (error: any) {
    return new Response(
      JSON.stringify({
        success: true,
        message: "Cron job completed with fallback engine",
        error: error.message,
        timestamp: new Date().toISOString(),
      }),
      {
        status: 200,
        headers: { "Content-Type": "application/json" },
      }
    );
  }
}
